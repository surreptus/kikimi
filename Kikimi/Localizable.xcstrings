    "Saved %@ to %@. In Anki, choose File > Import and pick %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saved %1$@ to %2$@. In Anki, choose File > Import and pick %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardó %@ en %@. En Anki, elige Archivo > Importar y selecciona %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré : %@ dans %@. Dans Anki, choisissez Fichier > Importer et sélectionnez %@."

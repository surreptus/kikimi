    "Translating from %@ to %@ needs a language download. Add it in System Settings > General > Language & Region > Translation Languages." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Translating from %1$@ to %2$@ needs a language download. Add it in System Settings > General > Language & Region > Translation Languages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traducir de %@ a %@ requiere descargar un idioma. Añádelo en Ajustes del Sistema > General > Idioma y región > Idiomas de traducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduire de %@ vers %@ nécessite le téléchargement d’une langue. Ajoutez-la dans Réglages Système > Général > Langue et région > Langues de traduction."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

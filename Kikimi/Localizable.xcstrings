    "Got it moves a word up a stage. Missed it moves it down one, never below Stage 1." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Gewusst“ bringt ein Wort eine Stufe höher. „Nicht gewusst“ setzt es eine Stufe zurück, nie unter Stufe 1."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Lo sabía» sube una palabra una etapa. «Fallé» la baja una, nunca por debajo de la etapa 1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Réussi » fait monter un mot d’un niveau. « Raté » le fait descendre d’un niveau, jamais en dessous du niveau 1."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「正解」で単語のステージが1つ上がり、「不正解」で1つ下がります。ステージ1より下にはなりません。"
          }
        }
      }
    },

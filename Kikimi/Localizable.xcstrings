    },
    "• %lld aren't in your library yet, so there's nothing to change; they'll be new when they appear in a video." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• %lld aún no están en tu biblioteca, así que no hay nada que cambiar; serán nuevas cuando aparezcan en un vídeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• %lld ne sont pas encore dans votre bibliothèque, donc rien ne change ; ils seront nouveaux quand ils apparaîtront dans une vidéo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• %lld sind noch nicht in deiner Bibliothek, es gibt also nichts zu ändern; sie sind neu, sobald sie in einem Video vorkommen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• %lld 語はまだライブラリにないため、変更はありません。動画に登場したときに新規になります。"
          }
        }
      }
    },
    "• ^[%lld entry](inflect: true) couldn't be read and will be skipped." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Entradas que no se pudieron leer y se omitirán: %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Entrées illisibles qui seront ignorées : %lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Nicht lesbare Einträge, die übersprungen werden: %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 読み取れずスキップする項目: %lld 件。"
          }
        }
      }
    },
    "• ^[%lld video](inflect: true) already here will be left as they are." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Vídeos que ya están aquí y se dejarán como están: %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Vidéos déjà présentes, laissées telles quelles : %lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Bereits vorhandene Videos bleiben unverändert: %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• すでにある動画 %lld 本はそのままにします。"
          }
        }
      }
    },
    "• ^[%lld video](inflect: true) can't be restored: the files are missing from the folder." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Vídeos que no se pueden restaurar porque faltan los archivos en la carpeta: %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Vidéos impossibles à restaurer, car leurs fichiers manquent dans le dossier : %lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Videos, die nicht wiederhergestellt werden können, weil die Dateien im Ordner fehlen: %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• ファイルがフォルダにないため復元できない動画: %lld 本。"
          }
        }
      }
    },
    "• ^[%lld video](inflect: true) will be added (%@), with transcripts and words." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• ^[%1$lld video](inflect: true) will be added (%2$@), with transcripts and words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Vídeos que se añadirán, con sus transcripciones y palabras: %lld (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Vidéos qui seront ajoutées, avec leurs transcriptions et leurs mots : %lld (%@)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Videos, die hinzugefügt werden, samt Transkripten und Wörtern: %lld (%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 文字起こしと単語を含め、動画 %lld 本を追加します (%@)。"
          }
        }
      }
    },
    "• ^[%lld word](inflect: true) here will take the backup's progress." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Palabras de aquí que tomarán el progreso de la copia: %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Mots d’ici qui reprendront la progression de la sauvegarde : %lld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Wörter hier, die den Fortschritt der Sicherung übernehmen: %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• バックアップの進捗を引き継ぐ単語: %lld 語。"
          }
        }
      }
    },
    "• ^[%lld word](inflect: true) not in your library yet will be added, and join their sentences when you add the videos." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Palabras que aún no están en tu biblioteca y se añadirán; se unirán a sus frases cuando añadas los vídeos: %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Mots pas encore dans votre bibliothèque, qui seront ajoutés et retrouveront leurs phrases quand vous ajouterez les vidéos : %lld."
          }
        },
        "de" : {

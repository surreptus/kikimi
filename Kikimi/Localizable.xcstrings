    "Hard is under 80%, A stretch is 80 to 88%, Comfortable is 88 to 98%, and Easy is 98% or more." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difícil es menos del 80 %, Un reto es del 80 al 88 %, Cómodo es del 88 al 98 % y Fácil es el 98 % o más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difficile : moins de 80 %. Un défi : de 80 à 88 %. Confortable : de 88 à 98 %. Facile : 98 % ou plus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwer ist unter 80 %, Fordernd ist 80 bis 88 %, Angenehm ist 88 bis 98 % und Leicht ist 98 % oder mehr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「難しい」は80%未満、「少し難しい」は80〜88%、「快適」は88〜98%、「易しい」は98%以上です。"
          }
        }

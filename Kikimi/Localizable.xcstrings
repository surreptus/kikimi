    "Checks the copy plays and is the right length before anything is kept." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que la copia se reproduce y que tiene la duración correcta antes de conservar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie que la copie se lit et qu’elle a la bonne durée avant de rien conserver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft, ob sich die Kopie abspielen lässt und die richtige Länge hat, bevor etwas behalten wird."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何かを保存する前に、コピーが再生でき、長さが正しいことを確認します。"
          }
        }
      }
    },
    "Checks whether you've already added this video, by its contents rather than its name." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba si ya añadiste este vídeo, por su contenido y no por su nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie si vous avez déjà ajouté cette vidéo, d’après son contenu plutôt que son nom."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft, ob du dieses Video schon hinzugefügt hast – anhand des Inhalts, nicht des Namens."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この動画をすでに追加したかを、名前ではなく内容で確認します。"
          }
        }
      }
    },
    "Choose a backup file or folder, or drop one on this window. You'll see what would change before anything does, and progress and videos you already have are never overwritten." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un archivo o una carpeta de copia, o suéltalo en esta ventana. Verás qué cambiaría antes de que cambie nada, y el progreso y los vídeos que ya tienes nunca se sobrescriben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un fichier ou un dossier de sauvegarde, ou déposez-le sur cette fenêtre. Vous verrez ce qui changerait avant que quoi que ce soit ne change, et la progression et les vidéos que vous avez déjà ne sont jamais écrasées."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Sicherungsdatei oder einen Sicherungsordner oder lege ihn auf diesem Fenster ab. Du siehst, was sich ändern würde, bevor sich etwas ändert, und vorhandener Fortschritt und vorhandene Videos werden nie überschrieben."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップのファイルまたはフォルダを選ぶか、このウインドウにドロップしてください。変更される内容は実行前に確認でき、すでにある進捗や動画が上書きされることはありません。"
          }
        }
      }
    },
    "Choose a backup file, or a backup folder" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un archivo de copia o una carpeta de copia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un fichier ou un dossier de sauvegarde"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Sicherungsdatei oder einen Sicherungsordner"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップのファイルまたはフォルダを選択"
          }
        }
      }
    },
    "Choose a folder for the %@ clips" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una carpeta para los clips de %@"
          }
        },

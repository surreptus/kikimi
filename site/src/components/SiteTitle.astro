---
// Starlight's own site title, with a link to the guide beside it, so every page (the homepage too, which has no sidebar)
// has a way in.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const onGuide = Astro.url.pathname.startsWith(`${base}/guide/`);
---
<Default><slot /></Default>
<a class="guide-link" href={`${base}/guide/`} aria-current={onGuide ? 'page' : undefined}>Guide</a>

<style>
  .guide-link {
    margin-inline-start: 1.25rem;
    align-self: center;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-text);
    text-decoration: none;
  }
  .guide-link:hover, .guide-link[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; }
</style>

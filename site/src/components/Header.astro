---
// The site's top bar. `current` marks the page you are on, for screen readers and for sighted readers.
interface Props { current?: 'guide' | 'download' | 'faq' | 'changelog' }
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  ['guide', 'Guide', `${base}/guide/`],
  ['download', 'Download', `${base}/download/`],
  ['faq', 'FAQ', `${base}/faq/`],
  ['changelog', 'Changelog', `${base}/changelog/`],
] as const;
---
<header class="site-header">
  <a class="brand" href={`${base}/`}><img src={`${base}/icon.svg`} alt="" width="34" height="34" />Kikimi</a>
  <nav aria-label="Site">
    {links.map(([id, label, href]) => <a href={href} aria-current={current === id ? 'page' : undefined}>{label}</a>)}
    <a href="https://github.com/surreptus/kikimi">Source</a>
  </nav>
</header>

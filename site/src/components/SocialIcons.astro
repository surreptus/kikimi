---
// Starlight's own links (GitHub), with a link to the guide before them, at the right of the toolbar. On a narrow window
// Starlight hides this group, and the site title carries a link instead.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const onGuide = Astro.url.pathname.startsWith(`${base}/guide/`);
---
<a class="guide-link" href={`${base}/guide/`} aria-current={onGuide ? 'page' : undefined}>Guide</a>
<Default><slot /></Default>

<style>
  .guide-link {
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-text);
    text-decoration: none;
  }
  .guide-link:hover, .guide-link[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; }
</style>

---
// The version is the one in latest.json, which the app's Check for Updates also reads, and which is only raised once a
// release is published. The link goes to the Releases page, where the zip and its checksum are.
import latest from '../../public/latest.json';
interface Props { label?: string }
const { label } = Astro.props;
---
<a class="button" href={latest.url}>{label ?? `Download Kikimi ${latest.version}`}</a>

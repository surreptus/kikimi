---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
// The licence texts are the app's own files, so the website and the app show the same notices.
const files = import.meta.glob('../../../LangCore/Sources/LangCore/Resources/Licenses/*.txt', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const titles: Record<string, string> = {
  'Kikimi-MIT': 'Kikimi (this app)',
  'JMdict-EDRDG': 'JMdict dictionary data',
  'KANJIDIC-EDRDG': 'KANJIDIC2 kanji data',
  'Wiktionary-kaikki': 'Spanish, French and German dictionary data (Wiktionary)',
  'IPADIC-COPYING': 'IPADIC dictionary (NAIST, ICOT)',
  'MeCab-BSD': 'MeCab morphological analyzer',
  'OpenAI-Whisper': 'Whisper speech recognition',
  'WhisperKit-MIT': 'WhisperKit',
  'swift-transformers-Apache-2.0': 'swift-transformers (Hugging Face), inside WhisperKit',
  'GRDB-MIT': 'GRDB.swift',
};
const items = Object.entries(files)
  .map(([path, text]) => { const key = path.split('/').pop()!.replace('.txt', ''); return { title: titles[key] ?? key, text }; })
  .sort((a, b) => a.title.localeCompare(b.title));
---
<StarlightPage frontmatter={{ title: 'Acknowledgements', tableOfContents: false, description: 'The software, models and data Kikimi uses, and their licences.' }}>
  <p>Kikimi is free software under the MIT licence. It uses the software, models and data below, each under its own licence.</p>
  {items.map((item) => (
    <details class="licence">
      <summary>{item.title}</summary>
      <pre>{item.text}</pre>
    </details>
  ))}
  <h2 id="website">This website</h2>
  <p>
    The website is built with <a href="https://astro.build">Astro</a> and <a href="https://starlight.astro.build">Starlight</a>,
    and its search is <a href="https://pagefind.app">Pagefind</a>. All three are under the MIT licence. The site loads no
    other software, fonts or scripts from anywhere else.
  </p>

  <h2 id="pictures">Pictures on this website</h2>
  <p>
    The screenshot of the player on the home page shows a video by 料理研究家リュウジのバズレシピ (Ryuji's Buzz Recipes),
    <a href="https://www.youtube.com/watch?v=holOKD9U0yw">『100g68円の鶏むね肉を信じられないほど柔らかく美味しく食べるただ一つの方法【至高のとり天】』</a>,
    published under the <a href="https://creativecommons.org/licenses/by/4.0/">Creative Commons Attribution licence</a>
    and copied to <a href="https://commons.wikimedia.org/wiki/File:100g68円の鶏むね肉を信じられないほど柔らかく美味しく食べるただ一つの方法【至高のとり天】『Supreme_chicken_temp』.webm">Wikimedia Commons</a>.
    It is a frame of that video shown inside Kikimi, so it is changed from the original. The creator does not endorse Kikimi.
  </p>
</StarlightPage>

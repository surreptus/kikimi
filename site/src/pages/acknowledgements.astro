---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
// The licence texts are the app's own files, so the website and the app show the same notices.
const files = import.meta.glob('../../../LangCore/Sources/LangCore/Resources/Licenses/*.txt', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const titles: Record<string, string> = {
  'Kikimi-MIT': 'Kikimi (this app)',
  'JMdict-EDRDG': 'JMdict dictionary data',
  'KANJIDIC-EDRDG': 'KANJIDIC2 kanji data',
  'Wiktionary-kaikki': 'Spanish, French and German dictionary data (Wiktionary)',
  'IPADIC-COPYING': 'IPADIC dictionary (NAIST, ICOT)',
  'MeCab-BSD': 'MeCab morphological analyzer',
  'OpenAI-Whisper': 'Whisper speech recognition',
  'WhisperKit-MIT': 'WhisperKit',
  'swift-transformers-Apache-2.0': 'swift-transformers (Hugging Face), inside WhisperKit',
  'GRDB-MIT': 'GRDB.swift',
};
const items = Object.entries(files)
  .map(([path, text]) => { const key = path.split('/').pop()!.replace('.txt', ''); return { title: titles[key] ?? key, text }; })
  .sort((a, b) => a.title.localeCompare(b.title));
---
<StarlightPage frontmatter={{ title: 'Acknowledgements', tableOfContents: false, description: 'The software, models and data Kikimi uses, and their licences.' }}>
  <p>Kikimi is free software under the MIT licence. It uses the software, models and data below, each under its own licence.</p>
  {items.map((item) => (
    <details class="licence">
      <summary>{item.title}</summary>
      <pre>{item.text}</pre>
    </details>
  ))}
</StarlightPage>
